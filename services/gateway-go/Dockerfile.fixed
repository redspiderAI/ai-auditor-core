# 使用官方Golang镜像作为构建环境（升级以减少已知漏洞）
FROM golang:1.22.7-bookworm AS builder

# 设置工作目录
WORKDIR /app

# 配置国内代理以加速依赖下载，可按需替换
RUN go env -w GO111MODULE=on \
    && go env -w GOPROXY=https://mirrors.aliyun.com/goproxy/,direct

# 复制go.mod和go.sum文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 构建应用
RUN CGO_ENABLED=0 GOOS=linux go build -o gateway .

# 使用国内镜像源的轻量级运行时镜像，替代gcr.io镜像
FROM debian:bookworm-slim

# 创建非root用户
RUN groupadd -g 65532 nonroot && \
    useradd -u 65532 -g nonroot -s /bin/bash -d /app nonroot && \
    mkdir -p /app && \
    chown -R nonroot:nonroot /app

# 设置工作目录
WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=builder /app/gateway /app/gateway

# 更改文件权限
RUN chmod +x /app/gateway
RUN chown nonroot:nonroot /app/gateway

# 切换到非root用户
USER nonroot

# 暴露端口
EXPOSE 8080

# 运行应用
CMD ["/app/gateway"]
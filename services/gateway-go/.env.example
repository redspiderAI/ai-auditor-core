# AI Audit Gateway Configuration

# Server Configuration
GATEWAY_PORT=8080
TEMP_DIR=./temp_docs

# Queue Configuration
MAX_TASK_QUEUE_SIZE=100
CLEANUP_INTERVAL_HOURS=1
MAX_FILE_AGE_HOURS=24

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_STREAM=audit_tasks
REDIS_GROUP=gateway_group
REDIS_CONSUMER=gateway_consumer

# Storage Configuration
STORAGE_TYPE=redis          # Options: memory, redis
TASK_TTL_HOURS=24           # Time-to-live for tasks in Redis (hours)

# Logging
LOG_LEVEL=info

# Webhook Configuration
WEBHOOK_TIMEOUT_SECONDS=5
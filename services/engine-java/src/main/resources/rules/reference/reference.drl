// Rule 10: Monograph [M] Format Check - Missing Place of Publication: Publisher
rule "Monograph Reference Missing Place of Publication and Publisher Check"
when 
    $ref: Reference(rawText.contains("[M]") && !rawText.matches(".*[\\u4e00-\\u9fff\\w]+\\s*:\\s*[\\u4e00-\\u9fff\\w]+.*"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("Unable to parse reference number");
    }
    
    if (refNum > 0) {
        logger.debug("DEBUG: Monograph reference [{}] missing place of publication and publisher", refNum);
        results.add(Issue.newBuilder()
                .setCode("ERR_REF_MONO_NO_PUBLISHER")
                .setMessage("Reference [" + refNum + "] monograph format error: missing place of publication and publisher information")
                .setSectionId(0)
                .setSeverity(Severity.MEDIUM)
                .setSuggestion("Add place of publication and publisher information, format like Beijing: Publisher")
                .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                .build());
    }
end

// Rule 11: Monograph [M] Format Check - Multiple Authors but No 'et al.'
rule "Monograph Reference Multiple Authors Without Et Al Check"
when 
    $ref: Reference(rawText.contains("[M]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("Unable to parse reference number");
    }
    
    if (refNum > 0) {
        int typeIndex = rawText.indexOf("[M]");
        if (typeIndex > 0) {
            String authorPart = rawText.substring(0, typeIndex);
            int commaCount = 0;
            for (char c : authorPart.toCharArray()) {
                if (c == ',') {
                    commaCount++;
                }
            }
            
            if (commaCount > 2) {
                if (!authorPart.contains("等") && !authorPart.contains("et al.") && 
                    !authorPart.contains("et al") && !authorPart.contains("等.")) {
                    logger.debug("DEBUG: Monograph reference [{}] multiple authors but no et al.", refNum);
                    results.add(Issue.newBuilder()
                            .setCode("ERR_REF_MONO_MULTI_AUTHOR")
                            .setMessage("Reference [" + refNum + "] multiple authors format error: more than 2 authors should use 'et al.' or '等'")
                            .setSectionId(0)
                            .setSeverity(Severity.MEDIUM)
                            .setSuggestion("Add 'et al.' or '等' after the second author")
                            .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                            .build());
                }
            }
        }
    }
end

// Rule 12: Citation Consistency Check - Missing References
rule "Check Missing References"
when 
    $data: ParsedData()
then
    Set<Integer> citedNumbers = new HashSet<>();
    Set<Integer> existingRefNumbers = new HashSet<>();
    
    // Extract all citations in the main text
    for (Section section : $data.getSectionsList()) {
        Pattern citationPattern = Pattern.compile("\\[(\\d+)\\]");
        Matcher matcher = citationPattern.matcher(section.getText());
        while (matcher.find()) {
            try {
                citedNumbers.add(Integer.parseInt(matcher.group(1)));
            } catch (NumberFormatException e) {
                logger.warn("Unable to parse citation number");
            }
        }
    }
    
    // Extract all numbers in the reference list
    for (Reference ref : $data.getReferencesList()) {
        String refId = ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            try {
                String cleaned = refId.replaceAll("\\[|\\]", "").trim();
                existingRefNumbers.add(Integer.parseInt(cleaned));
            } catch (NumberFormatException e) {
                logger.warn("Unable to parse reference number");
            }
        }
    }
    
    // Check for missing citations
    for (Integer citedNum : citedNumbers) {
        if (!existingRefNumbers.contains(citedNum)) {
            logger.debug("DEBUG: Missing reference detected [{}]", citedNum);
            results.add(Issue.newBuilder()
                    .setCode("ERR_REF_MISSING")
                    .setMessage("Reference [" + citedNum + "] is cited in the main text but missing in the reference list")
                    .setSectionId(0)
                    .setSeverity(Severity.CRITICAL)
                    .setSuggestion("Please add reference [" + citedNum + "]")
                    .setOriginalSnippet("Citation [" + citedNum + "]")
                    .build());
        }
    }
end

// Rule 13: Journal [J] Format Check - Year Too Early
rule "Journal Reference Year Too Early Check"
when 
    $ref: Reference(rawText.contains("[J]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("Unable to parse reference number");
    }
    
    if (refNum > 0) {
        Pattern yearPattern = Pattern.compile("\\b(\\d{4})\\b");
        Matcher yearMatcher = yearPattern.matcher(rawText);
        
        while (yearMatcher.find()) {
            try {
                int year = Integer.parseInt(yearMatcher.group(1));
                
                if (year < 1900) {
                    logger.debug("DEBUG: Journal reference [{}] year {} < 1900", refNum, year);
                    results.add(Issue.newBuilder()
                            .setCode("ERR_REF_JOURNAL_YEAR_EARLY")
                            .setMessage("Reference [" + refNum + "] year too early: " + year + " < 1900")
                            .setSectionId(0)
                            .setSeverity(Severity.MEDIUM)
                            .setSuggestion("Please check if the year is correct")
                            .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                            .build());
                }
            } catch (NumberFormatException e) {
                logger.warn("Unable to parse year");
            }
        }
    }
end


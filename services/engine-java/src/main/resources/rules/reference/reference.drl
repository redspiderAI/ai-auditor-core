package rules.reference

import com.auditor.grpc.*
import org.slf4j.Logger
import java.util.regex.Pattern
import java.util.regex.Matcher
import java.util.*

global java.util.List results
global Logger logger

dialect "java"

// ==================== 规则定义 ====================

// 规则1: 期刊 [J] 格式检查 - 全角逗号检查
rule "期刊文献全角逗号检查"
when 
    $ref: Reference(rawText.contains("[J]") && rawText.contains("，"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        logger.debug("DEBUG: 期刊文献 [{}] 检查到全角逗号", refNum);
        results.add(Issue.newBuilder()
                .setCode("ERR_REF_JOURNAL_FULL_COMMA")
                .setMessage("参考文献 [" + refNum + "] 期刊格式错误：使用了全角逗号，应使用英文逗号")
                .setSectionId(0)
                .setSeverity(Severity.HIGH)
                .setSuggestion("将全角逗号（，）替换为英文逗号（,）")
                .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                .build());
    }
end

// 规则2: 期刊 [J] 格式检查 - 年份超出范围
rule "期刊文献年份超出范围检查"
when 
    $ref: Reference(rawText.contains("[J]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        Pattern yearPattern = Pattern.compile("\\b(\\d{4})\\b");
        Matcher yearMatcher = yearPattern.matcher(rawText);
        
        while (yearMatcher.find()) {
            try {
                int year = Integer.parseInt(yearMatcher.group(1));
                int currentYear = 2026;
                
                if (year > currentYear) {
                    logger.debug("DEBUG: 期刊文献 [{}] 年份 {} > {}", refNum, year, currentYear);
                    results.add(Issue.newBuilder()
                            .setCode("ERR_REF_JOURNAL_YEAR_EXCEED")
                            .setMessage("参考文献 [" + refNum + "] 年份超出范围：" + year + " > " + currentYear)
                            .setSectionId(0)
                            .setSeverity(Severity.HIGH)
                            .setSuggestion("请检查年份是否正确")
                            .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                            .build());
                }
            } catch (NumberFormatException e) {
                logger.warn("无法解析年份");
            }
        }
    }
end

// 规则3: 期刊 [J] 格式检查 - [J] 后面没有点号
rule "期刊文献J标记后无点号检查"
when 
    $ref: Reference(rawText.contains("[J]") && !rawText.contains("[J]."))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        logger.debug("DEBUG: 期刊文献 [{}] [J] 后面没有点号", refNum);
        results.add(Issue.newBuilder()
                .setCode("ERR_REF_JOURNAL_NO_DOT")
                .setMessage("参考文献 [" + refNum + "] 期刊格式错误：[J] 后面应有句点")
                .setSectionId(0)
                .setSeverity(Severity.HIGH)
                .setSuggestion("在 [J] 后面添加英文句点")
                .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                .build());
    }
end

// 规则4: 期刊 [J] 格式检查 - 缺少卷(期)
rule "期刊文献缺少卷期检查"
when 
    $ref: Reference(rawText.contains("[J]") && !rawText.matches(".*\\d+\\s*\\(\\s*\\d+\\s*\\).*"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        logger.debug("DEBUG: 期刊文献 [{}] 缺少卷(期)", refNum);
        results.add(Issue.newBuilder()
                .setCode("ERR_REF_JOURNAL_NO_VOLUME")
                .setMessage("参考文献 [" + refNum + "] 期刊格式错误：缺少卷(期)信息")
                .setSectionId(0)
                .setSeverity(Severity.MEDIUM)
                .setSuggestion("添加卷(期)信息，格式如 10(2)")
                .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                .build());
    }
end

// 规则5: 期刊 [J] 格式检查 - 缺少页码
rule "期刊文献缺少页码检查"
when 
    $ref: Reference(rawText.contains("[J]") && !rawText.matches(".*:\\s*\\d+\\s*[-~]?\\s*\\d*.*"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        logger.debug("DEBUG: 期刊文献 [{}] 缺少页码", refNum);
        results.add(Issue.newBuilder()
                .setCode("ERR_REF_JOURNAL_NO_PAGE")
                .setMessage("参考文献 [" + refNum + "] 期刊格式错误：缺少页码信息")
                .setSectionId(0)
                .setSeverity(Severity.MEDIUM)
                .setSuggestion("添加页码信息，格式如 1-10")
                .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                .build());
    }
end

// 规则6: 期刊 [J] 格式检查 - 多作者但没有"等"
rule "期刊文献多作者无等检查"
when 
    $ref: Reference(rawText.contains("[J]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        int typeIndex = rawText.indexOf("[J]");
        if (typeIndex > 0) {
            String authorPart = rawText.substring(0, typeIndex);
            int commaCount = 0;
            for (char c : authorPart.toCharArray()) {
                if (c == ',') {
                    commaCount++;
                }
            }
            
            if (commaCount > 2) {
                if (!authorPart.contains("等") && !authorPart.contains("et al.") && 
                    !authorPart.contains("et al") && !authorPart.contains("等.")) {
                    logger.debug("DEBUG: 期刊文献 [{}] 多作者但没有等", refNum);
                    results.add(Issue.newBuilder()
                            .setCode("ERR_REF_JOURNAL_MULTI_AUTHOR")
                            .setMessage("参考文献 [" + refNum + "] 多作者格式错误：超过2个作者应使用'等'或'et al.'")
                            .setSectionId(0)
                            .setSeverity(Severity.MEDIUM)
                            .setSuggestion("在第2个作者后添加'等'或'et al.'")
                            .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                            .build());
                }
            }
        }
    }
end


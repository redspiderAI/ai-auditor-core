                .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                .build());
    }
end


// 规则16: 期刊 [J] 格式检查 - 年份为两位数（在逗号后面）
rule "期刊文献年份两位数检查"
when 
    $ref: Reference(rawText.contains("[J]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        // 只检查在逗号后面的两位数年份
        Pattern twoDigitYearPattern = Pattern.compile(",\\s*(\\d{2})\\s*,");
        Matcher matcher = twoDigitYearPattern.matcher(rawText);
        
        if (matcher.find()) {
            String twoDigit = matcher.group(1);
            try {
                int year = Integer.parseInt(twoDigit);
                logger.debug("DEBUG: 期刊文献 [{}] 年份为两位数 {}", refNum, twoDigit);
                results.add(Issue.newBuilder()
                        .setCode("ERR_REF_JOURNAL_YEAR_TWO_DIGIT")
                        .setMessage("参考文献 [" + refNum + "] 年份格式错误：年份应为四位数，而非两位数 " + twoDigit)
                        .setSectionId(0)
                        .setSeverity(Severity.MEDIUM)
                        .setSuggestion("将两位数年份改为四位数，如 20" + twoDigit)
                        .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                        .build());
            } catch (NumberFormatException e) {
                logger.warn("无法解析年份");
            }
        }
    }
end

// 规则17: 专著 [M] 格式检查 - 年份为两位数（在逗号后面）
rule "专著文献年份两位数检查"
when 
    $ref: Reference(rawText.contains("[M]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        // 只检查在逗号后面的两位数年份或末尾的两位数
        Pattern twoDigitYearPattern = Pattern.compile(",\\s*(\\d{2})\\s*[,.]$");
        Matcher matcher = twoDigitYearPattern.matcher(rawText);
        
        if (matcher.find()) {
            String twoDigit = matcher.group(1);
            try {
                int year = Integer.parseInt(twoDigit);
                logger.debug("DEBUG: 专著文献 [{}] 年份为两位数 {}", refNum, twoDigit);
                results.add(Issue.newBuilder()
                        .setCode("ERR_REF_MONO_YEAR_TWO_DIGIT")
                        .setMessage("参考文献 [" + refNum + "] 年份格式错误：年份应为四位数，而非两位数 " + twoDigit)
                        .setSectionId(0)
                        .setSeverity(Severity.MEDIUM)
                        .setSuggestion("将两位数年份改为四位数，如 20" + twoDigit)
                        .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                        .build());
            } catch (NumberFormatException e) {
                logger.warn("无法解析年份");
            }
        }
    }
end

// 规则18: 期刊 [J] 格式检查 - 缺少作者
rule "期刊文献缺少作者检查"
when 
    $ref: Reference(rawText.contains("[J]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("无法解析参考文献编号");
    }
    
    if (refNum > 0) {
        int typeIndex = rawText.indexOf("[J]");
        if (typeIndex > 0) {
            String beforeType = rawText.substring(0, typeIndex);
            // 检查是否没有作者（即 [J] 前面没有句点或没有足够的文本）
            if (!beforeType.contains(".") || beforeType.trim().length() < 3) {
                logger.debug("DEBUG: 期刊文献 [{}] 缺少作者", refNum);
                results.add(Issue.newBuilder()
                        .setCode("ERR_REF_JOURNAL_NO_AUTHOR")
                        .setMessage("参考文献 [" + refNum + "] 期刊格式错误：缺少作者信息")
                        .setSectionId(0)
                        .setSeverity(Severity.HIGH)
                        .setSuggestion("添加作者信息，格式如 作者. 题名[J].")
                        .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                        .build());
            }
        }
    }
end


// Rule 16: Journal [J] Format Check - Year is Two Digits (after comma)
rule "Journal Reference Two-Digit Year Check"
when 
    $ref: Reference(rawText.contains("[J]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("Unable to parse reference number");
    }
    
    if (refNum > 0) {
        // Only check two-digit year after comma
        Pattern twoDigitYearPattern = Pattern.compile(",\\s*(\\d{2})\\s*,");
        Matcher matcher = twoDigitYearPattern.matcher(rawText);
        
        if (matcher.find()) {
            String twoDigit = matcher.group(1);
            try {
                int year = Integer.parseInt(twoDigit);
                logger.debug("DEBUG: Journal reference [{}] year is two digits {}", refNum, twoDigit);
                results.add(Issue.newBuilder()
                        .setCode("ERR_REF_JOURNAL_YEAR_TWO_DIGIT")
                        .setMessage("Reference [" + refNum + "] year format error: year should be four digits, not two digits " + twoDigit)
                        .setSectionId(0)
                        .setSeverity(Severity.MEDIUM)
                        .setSuggestion("Change two-digit year to four digits, e.g. 20" + twoDigit)
                        .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                        .build());
            } catch (NumberFormatException e) {
                logger.warn("Unable to parse year");
            }
        }
    }
end

// Rule 17: Monograph [M] Format Check - Year is Two Digits (after comma)
rule "Monograph Reference Year Two-Digit Check"
when 
    $ref: Reference(rawText.contains("[M]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("Unable to parse reference number");
    }
    
    if (refNum > 0) {
        // Only check two-digit year after comma or at the end
        Pattern twoDigitYearPattern = Pattern.compile(",\\s*(\\d{2})\\s*[,.]$");
        Matcher matcher = twoDigitYearPattern.matcher(rawText);
        
        if (matcher.find()) {
            String twoDigit = matcher.group(1);
            try {
                int year = Integer.parseInt(twoDigit);
                logger.debug("DEBUG: Monograph reference [{}] year is two digits {}", refNum, twoDigit);
                results.add(Issue.newBuilder()
                        .setCode("ERR_REF_MONO_YEAR_TWO_DIGIT")
                        .setMessage("Reference [" + refNum + "] year format error: year should be four digits, not two digits " + twoDigit)
                        .setSectionId(0)
                        .setSeverity(Severity.MEDIUM)
                        .setSuggestion("Change two-digit year to four digits, e.g. 20" + twoDigit)
                        .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                        .build());
            } catch (NumberFormatException e) {
                logger.warn("Unable to parse year");
            }
        }
    }
end

// Rule 18: Journal [J] Format Check - Missing Author
rule "Journal Reference Missing Author Check"
when 
    $ref: Reference(rawText.contains("[J]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("Unable to parse reference number");
    }
    
    if (refNum > 0) {
        int typeIndex = rawText.indexOf("[J]");
        if (typeIndex > 0) {
            String beforeType = rawText.substring(0, typeIndex);
            // Check if no author (i.e. no period before [J] or insufficient text)
            if (!beforeType.contains(".") || beforeType.trim().length() < 3) {
                logger.debug("DEBUG: Journal reference [{}] missing author", refNum);
                results.add(Issue.newBuilder()
                        .setCode("ERR_REF_JOURNAL_NO_AUTHOR")
                        .setMessage("Reference [" + refNum + "] journal format error: missing author information")
                        .setSectionId(0)
                        .setSeverity(Severity.HIGH)
                        .setSuggestion("Add author information, format like Author. Title[J].")
                        .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                        .build());
            }
        }
    }
end

// Rule 19: Monograph [M] Format Check - Missing Author
rule "Monograph Reference Missing Author Check"
when 
    $ref: Reference(rawText.contains("[M]"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("Unable to parse reference number");
    }
    
    if (refNum > 0) {
        int typeIndex = rawText.indexOf("[M]");
        if (typeIndex > 0) {
            String beforeType = rawText.substring(0, typeIndex);
            // Check if no author (i.e. no period before [M] or insufficient text)
            if (!beforeType.contains(".") || beforeType.trim().length() < 3) {
                logger.debug("DEBUG: Monograph reference [{}] missing author", refNum);
                results.add(Issue.newBuilder()
                        .setCode("ERR_REF_MONO_NO_AUTHOR")
                        .setMessage("Reference [" + refNum + "] monograph format error: missing author information")
                        .setSectionId(0)
                        .setSeverity(Severity.HIGH)
                        .setSuggestion("Add author information, format like Author. Book Title[M].")
                        .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                        .build());
            }
        }
    }
end


// Rule 20: Check Unused References
rule "Check Unused References"
when 
    $data: ParsedData()
then
    Set<Integer> citedNumbers = new HashSet<>();
    Set<Integer> existingRefNumbers = new HashSet<>();
    
    // Extract all citations in the main text
    for (Section section : $data.getSectionsList()) {
        Pattern citationPattern = Pattern.compile("\\[(\\d+)\\]");
        Matcher matcher = citationPattern.matcher(section.getText());
        while (matcher.find()) {
            try {
                citedNumbers.add(Integer.parseInt(matcher.group(1)));
            } catch (NumberFormatException e) {
                logger.warn("Unable to parse citation number");
            }
        }
    }
    
    // Extract all numbers in the reference list
    for (Reference ref : $data.getReferencesList()) {
        String refId = ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            try {
                String cleaned = refId.replaceAll("\\[|\\]", "").trim();
                existingRefNumbers.add(Integer.parseInt(cleaned));
            } catch (NumberFormatException e) {
                logger.warn("Unable to parse reference number");
            }
        }
    }
    
    // Check for unused references
    for (Integer refNum : existingRefNumbers) {
        if (!citedNumbers.contains(refNum)) {
            logger.debug("DEBUG: Found unused reference [{}]", refNum);
            results.add(Issue.newBuilder()
                    .setCode("WARN_REF_UNUSED")
                    .setMessage("Reference [" + refNum + "] is not cited in the main text")
                    .setSectionId(0)
                    .setSeverity(Severity.LOW)
                    .setSuggestion("Delete unused references or add citations in the main text")
                    .setOriginalSnippet("")
                    .build());
        }
    }
end


// ==================== New Rules: Check Required Fields ====================

// Rule 21: Monograph [M] - Missing Place of Publication
rule "Monograph Reference Missing Place of Publication Check"
when 
    $ref: Reference(rawText.contains("[M]") && !rawText.matches(".*[：:].*"))
then
    String rawText = $ref.getRawText();
    int refNum = 0;
    try {
        String refId = $ref.getRefId();
        if (refId != null && !refId.isEmpty()) {
            String cleaned = refId.replaceAll("\\[|\\]", "").trim();
            refNum = Integer.parseInt(cleaned);
        }
    } catch (Exception e) {
        logger.warn("Unable to parse reference number");
    }
    
    if (refNum > 0) {
        logger.debug("DEBUG: Monograph reference [{}] missing place of publication", refNum);
        results.add(Issue.newBuilder()
                .setCode("ERR_REF_MONO_NO_PLACE")
                .setMessage("Reference [" + refNum + "] monograph format error: missing place of publication")
                .setSectionId(0)
                .setSeverity(Severity.HIGH)
                .setSuggestion("Add place of publication information, format as Place:")
                .setOriginalSnippet(rawText.length() > 150 ? rawText.substring(0, 150) + "..." : rawText)
                .build());
    }
end


package rules.reference

import com.auditor.grpc.*
import org.slf4j.Logger
import java.util.regex.Pattern
import java.util.regex.Matcher
import java.util.BitSet
import java.util.*

global java.util.List results
global Logger logger

// 常量定义
dialect"java"

// 全局函数：检查引用格式
function void checkReferenceFormat(Reference ref,List results,Logger logger){String rawText=ref.getRawText();int refNum=extractReferenceNumber(ref.getRefId());

if(refNum<=0){return;}

// 检查文献类型标识
Character docType=extractDocType(rawText);if(docType==null){results.add(createFormatIssue(refNum,"缺少文献类型标识（如 [M], [J], [D] 等）","请根据文献类型添加相应的标识",rawText));}else{
// 检查特定类型的必需字段
checkRequiredFields(refNum,docType,rawText,results);

// 检查通用格式
checkGeneralFormat(refNum,rawText,results);}}

// 辅助函数：解析引用编号
function int extractReferenceNumber(String refId){if(refId==null||refId.isEmpty()){return 0;}

try{String cleaned=refId.replaceAll("\\[|\\]","").trim();return Integer.parseInt(cleaned);}catch(NumberFormatException e){System.err.println("无法解析参考文献编号: " + refId);return 0;}}

// 辅助函数：提取文献类型
function Character extractDocType(String rawText){Pattern pattern=Pattern.compile("\\[([MCJNDRSP])\\]");Matcher matcher=pattern.matcher(rawText);return matcher.find()?matcher.group(1).charAt(0):null;}

// 辅助函数：检查必需字段
function void checkRequiredFields(int refNum,Character docType,String rawText,List results){Map<Character,String>DOC_TYPE_MAP=Map.of('M',"专著",'C',"会议录",'N',"报纸文章",'J',"期刊文章",'D',"学位论文",'R',"报告",'S',"标准",'P',"专利");

Map<Character,Set<String>>REQUIRED_FIELDS=Map.of('M',new HashSet<>(Arrays.asList("作者","书名","出版地","出版者","出版年")),'J',new HashSet<>(Arrays.asList("作者","题名","刊名","年","卷","期","页码")),'D',new HashSet<>(Arrays.asList("作者","题名","保存地","保存单位","年份")),'C',new HashSet<>(Arrays.asList("作者","题名","会议名称","会议地点","会议日期")));

Set<String>required=REQUIRED_FIELDS.get(docType);if(required==null){return;}

for(String field:required){if(!rawText.contains(field)){String typeName=DOC_TYPE_MAP.getOrDefault(docType,"未知类型");results.add(createFormatIssue(refNum,typeName+" 缺少必需字段: "+field,"请补充 "+field+" 信息",rawText));}}

if(docType=='M'&&!rawText.contains(":")){results.add(createFormatIssue(refNum,"专著格式不完整，缺少出版地:出版者信息","格式应为: 作者. 书名[M]. 出版地: 出版者, 出版年.",rawText));}

if(docType=='J'&&!rawText.matches(".*\\d{4}.*,\\s*\\d+.*\\(.*\\).*")){results.add(createFormatIssue(refNum,"期刊文章格式不完整，缺少卷期信息","格式应为: 作者. 题名[J]. 刊名, 年, 卷(期): 页码.",rawText));}}

// 辅助函数：检查通用格式
function void checkGeneralFormat(int refNum,String rawText,List results){if(rawText.contains("，")||rawText.contains("。")){results.add(createFormatIssue(refNum,"使用了中文标点，应使用英文标点","请将中文标点（，。）替换为英文标点（,.）",rawText));}

if(!rawText.trim().endsWith(".")){results.add(createFormatIssue(refNum,"末尾缺少句点","请在参考文献末尾添加句点",rawText));}

if(!rawText.contains(".")||rawText.indexOf(".")>50){results.add(createFormatIssue(refNum,"作者格式可能不正确","作者名后应使用英文句点分隔",rawText));}}

// 辅助函数：创建格式问题 Issue
function Issue createFormatIssue(int refNum,String description,String suggestion,String rawText){return Issue.newBuilder().setCode("ERR_REF_FORMAT_"+refNum).setMessage("参考文献 ["+refNum+"] "+description).setSectionId(0).setSeverity(Severity.MEDIUM).setSuggestion(suggestion).setOriginalSnippet(rawText.length()>100?rawText.substring(0,100)+"...":rawText).build();}

// 辅助函数：创建一般问题 Issue
function Issue createIssue(String code,String message,int sectionId,Severity severity){return Issue.newBuilder().setCode(code).setMessage(message).setSectionId(sectionId).setSeverity(severity).setSuggestion("请根据建议进行修改").setOriginalSnippet("").build();}

// 辅助函数：提取引用数字
function List<Integer>extractCitationNumbers(String text){List<Integer>citations=new ArrayList<>();Pattern CITATION_PATTERN=Pattern.compile("\\[\\s*(\\d+(?:\\s*[-,\\s]\\s*\\d+)*)\\s*\\]");Matcher matcher=CITATION_PATTERN.matcher(text);

while(matcher.find()){String numbers=matcher.group(1);String[]parts=numbers.split("[,\\s]+");

for(String part:parts){if(part.contains("-")){String[]range=part.split("-");try{int start=Integer.parseInt(range[0].trim());int end=Integer.parseInt(range[1].trim());for(int i=start;i<=end;i++){citations.add(i);}}catch(NumberFormatException e){System.err.println("无法解析引用范围: " + part);}}else{try{citations.add(Integer.parseInt(part.trim()));}catch(NumberFormatException e){System.err.println("无法解析引用编号: " + part);}}}}

return citations;}

// 规则1: 检查参考文献格式
rule"检查参考文献格式"when $ref:Reference()then checkReferenceFormat($ref,results,logger);end

// 规则2: 检查参考文献顺序
rule"检查引用顺序"when $data:ParsedData()then
// 构建引用有向图
Map<Integer,List<Integer>>graph=new HashMap<>();

for(Section section:$data.getSectionsList()){List<Integer>citations=extractCitationNumbers(section.getText());if(!citations.isEmpty()){graph.put(section.getSectionId(),citations);}}

// 排序校验
List<Integer>orderedCitations=new ArrayList<>();graph.entrySet().stream().sorted(Map.Entry.comparingByKey()).forEach(entry->orderedCitations.addAll(entry.getValue()));

int lastCitation=0;for(int i=0;i<orderedCitations.size();i++){int current=orderedCitations.get(i);if(current<lastCitation){int violationSection=0;for(Map.Entry<Integer,List<Integer>>entry:graph.entrySet()){if(entry.getValue().contains(current)){violationSection=entry.getKey();break;}}

Issue issue=Issue.newBuilder().setCode("ERR_REF_ORDER_001").setMessage(String.format("引用序号不符合顺序编码制: [%d] 出现在 [%d] 之后，应为 [%d] 出现在 [%d] 之前",current,lastCitation,lastCitation,current)).setSectionId(violationSection).setSeverity(Severity.HIGH).setSuggestion("请按照引用在正文中出现的先后顺序重新编号").setOriginalSnippet(String.format("引用顺序错误: ...[%d]...[%d]...",lastCitation,current)).build();results.add(issue);break;}lastCitation=current;}end

// 规则3: 检查引用闭环
rule"检查引用闭环"when $data:ParsedData()then
// 构建引用有向图
Map<Integer,List<Integer>>graph=new HashMap<>();Set<Integer>citedNumbers=new HashSet<>();

for(Section section:$data.getSectionsList()){List<Integer>citations=extractCitationNumbers(section.getText());if(!citations.isEmpty()){graph.put(section.getSectionId(),citations);citedNumbers.addAll(citations);}}

// 获取现有的参考文献编号
Set<Integer>existingRefNumbers=new HashSet<>();for(Reference ref:$data.getReferencesList()){int refNum=extractReferenceNumber(ref.getRefId());if(refNum>0){existingRefNumbers.add(refNum);}}

// 检查缺失的引用
for(Integer citedNum:citedNumbers){if(!existingRefNumbers.contains(citedNum)){int sectionId=0;for(Map.Entry<Integer,List<Integer>>entry:graph.entrySet()){if(entry.getValue().contains(citedNum)){sectionId=entry.getKey();break;}}

Issue issue=Issue.newBuilder().setCode("ERR_REF_MISSING_001").setMessage("参考文献 ["+citedNum+"] 在正文中被引用，但在参考文献列表中缺失").setSectionId(sectionId).setSeverity(Severity.CRITICAL).setSuggestion("请添加参考文献 ["+citedNum+"]").setOriginalSnippet("引用 ["+citedNum+"]").build();results.add(issue);}}

// 检查未使用的引用
for(Integer refNum:existingRefNumbers){if(!citedNumbers.contains(refNum)){Issue issue=Issue.newBuilder().setCode("WARN_REF_UNUSED_001").setMessage("参考文献 ["+refNum+"] 在正文中未被引用").setSectionId(0).setSeverity(Severity.LOW).setSuggestion("删除未被引用的参考文献或在正文中添加引用").setOriginalSnippet("").build();results.add(issue);}}end

// 规则4: 位图算法检查
rule"位图算法检查"when $data:ParsedData()then
// 获取最大参考文献编号
int maxRefNumber=0;for(Reference ref:$data.getReferencesList()){int refNum=extractReferenceNumber(ref.getRefId());if(refNum>maxRefNumber){maxRefNumber=refNum;}}

if(maxRefNumber<=0){return;}

BitSet citationBitmap=new BitSet(maxRefNumber+1);BitSet referenceBitmap=new BitSet(maxRefNumber+1);

// 构建引用位图
for(Section section:$data.getSectionsList()){for(Integer citation:extractCitationNumbers(section.getText())){if(citation<=maxRefNumber&&citation>0){citationBitmap.set(citation);}}}

// 构建参考文献位图
for(Reference ref:$data.getReferencesList()){int refNum=extractReferenceNumber(ref.getRefId());if(refNum>0&&refNum<=maxRefNumber){referenceBitmap.set(refNum);}}

// 检查被引用但缺失的参考文献
BitSet citedButMissing=(BitSet)citationBitmap.clone();citedButMissing.andNot(referenceBitmap);

for(int i=citedButMissing.nextSetBit(0);i>=0;i=citedButMissing.nextSetBit(i+1)){results.add(Issue.newBuilder().setCode("ERR_REF_BITMAP_MISSING").setMessage("位图检查：参考文献 ["+i+"] 被引用但缺失").setSectionId(0).setSeverity(Severity.HIGH).setSuggestion("添加参考文献 ["+i+"]").setOriginalSnippet("").build());}

// 检查存在但未被引用的参考文献
BitSet existsButNotCited=(BitSet)referenceBitmap.clone();existsButNotCited.andNot(citationBitmap);

for(int i=existsButNotCited.nextSetBit(0);i>=0;i=existsButNotCited.nextSetBit(i+1)){results.add(Issue.newBuilder().setCode("WARN_REF_BITMAP_UNUSED").setMessage("位图检查：参考文献 ["+i+"] 存在但未被引用").setSectionId(0).setSeverity(Severity.LOW).setSuggestion("删除参考文献 ["+i+"] 或在正文中添加引用").setOriginalSnippet("").build());}

// 检查引用编号连续性
int firstCitation=citationBitmap.nextSetBit(0);if(firstCitation>0){int expected=firstCitation;for(int i=firstCitation;i<=maxRefNumber;i++){if(citationBitmap.get(i)){if(i!=expected){results.add(Issue.newBuilder().setCode("ERR_REF_BITMAP_GAP").setMessage("位图检查：引用编号不连续，缺少引用 ["+expected+"]").setSectionId(0).setSeverity(Severity.MEDIUM).setSuggestion("补充引用 ["+expected+"] 或重新编号").setOriginalSnippet("").build());break;}expected++;}}}

logger.debug("位图算法检查完成，最大编号: {}, 引用数: {}, 文献数: {}",maxRefNumber,citationBitmap.cardinality(),referenceBitmap.cardinality());end

// 规则5: 空数据检查
rule"空数据检查"when $data:ParsedData($data==null)then results.add(createIssue("ERR_REF_NULL","输入数据为空",0,Severity.CRITICAL));end